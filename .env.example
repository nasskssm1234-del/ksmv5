# Token du bot Discord (Developer Portal > Bot)
DISCORD_TOKEN=COLLE_TON_TOKEN_ICI

# Application ID (Developer Portal > General Information)
CLIENT_ID=COLLE_TON_APPLICATION_ID_ICI

# Volume par défaut : 1 à 200
DEFAULT_VOLUME=70

# Déconnexion automatique si la file est vide (minutes). 0 = désactivé.
AUTO_LEAVE_MINUTES=5

# Stabilité / protections
MAX_QUEUE=100
AUDIO_START_TIMEOUT_MS=30000

# Moteur : lavalink (défaut) ou legacy (ancien moteur YouTube)
MUSIC_ENGINE=lavalink
LAVALINK_HOST=lava-v4.millohost.my.id
LAVALINK_PORT=443
LAVALINK_PASSWORD=https://discord.gg/mjS5J2K3ep
LAVALINK_SECURE=true
